#!/bin/sh
set -eu

max_theme_environment_size=4096
platform=$(uname -s)

file_stat() {
	# Keep the requested metadata explicit: owner, link count, and byte size.
	if [ "$platform" = FreeBSD ]; then
		case $1 in
		u) format=%u ;;
		h) format=%l ;;
		s) format=%z ;;
		*) return 1 ;;
		esac
		stat -f "$format" -- "$2"
	else
		stat -c "%$1" -- "$2"
	fi
}

lock_theme_environment() {
	if [ "$platform" = FreeBSD ]; then
		# FreeBSD 15.1 lockf retains the lock on the inherited open descriptor.
		lockf -s -t 2 8
	else
		flock -w 2 8
	fi
}

decode_theme_environment_value() {
	encoded_value=$1
	decoded_value=
	while [ -n "$encoded_value" ]; do
		character=${encoded_value%"${encoded_value#?}"}
		encoded_value=${encoded_value#?}
		if [ "$character" = "\\" ]; then
			[ -n "$encoded_value" ] || return 1
			character=${encoded_value%"${encoded_value#?}"}
			encoded_value=${encoded_value#?}
		else
			case $character in
			[A-Za-z0-9._+@-]) ;;
			*) return 1 ;;
			esac
		fi
		decoded_value=$decoded_value$character
	done
	[ -n "$decoded_value" ] || return 1
}

parse_theme_environment() {
	theme_environment_file=$1
	parsed_qt_theme=
	parsed_cursor_theme=
	parsed_cursor_size=
	seen_qt=false
	seen_cursor=false
	seen_size=false
	while IFS= read -r environment_line || [ -n "$environment_line" ]; do
		case $environment_line in
		'# Auto-generated by theme-apply.sh '* | '') ;;
		'export QT_QPA_PLATFORMTHEME='*)
			[ "$seen_qt" = false ] || return 1
			decode_theme_environment_value "${environment_line#*=}" || return 1
			case $decoded_value in gtk3 | qt5ct | qt6ct) ;; *) return 1 ;; esac
			parsed_qt_theme=$decoded_value
			seen_qt=true
			;;
		'export XCURSOR_THEME='*)
			[ "$seen_cursor" = false ] || return 1
			decode_theme_environment_value "${environment_line#*=}" || return 1
			[ "${#decoded_value}" -le 255 ] || return 1
			case $decoded_value in */* | *\\* | *'|'* | *'&'* | . | ..) return 1 ;; esac
			parsed_cursor_theme=$decoded_value
			seen_cursor=true
			;;
		'export XCURSOR_SIZE='*)
			[ "$seen_size" = false ] || return 1
			decode_theme_environment_value "${environment_line#*=}" || return 1
			case $decoded_value in *[!0-9]* | '') return 1 ;; esac
			parsed_cursor_size=$decoded_value
			seen_size=true
			;;
		*) return 1 ;;
		esac
	done <"$theme_environment_file"
	[ "$seen_qt" = true ] && [ "$seen_cursor" = true ] && [ "$seen_size" = true ]
}

refresh_theme_environment() {
	config_home=${XDG_CONFIG_HOME:-}
	case $config_home in
	/*) ;;
	*) config_home=${HOME:?HOME is required}/.config ;;
	esac
	theme_env=$config_home/dwm-titus/theme-env.sh
	session_uid=$(id -u) || return 1
	runtime_base=${XDG_RUNTIME_DIR:-/tmp/dwm-titus-$session_uid}
	case $runtime_base in
	/*) ;;
	*) return 1 ;;
	esac
	if [ ! -e "$runtime_base" ]; then
		(umask 077 && mkdir -p -- "$runtime_base") || return 1
	fi
	if [ ! -d "$runtime_base" ] || [ -L "$runtime_base" ] ||
		[ "$(file_stat u "$runtime_base")" != "$session_uid" ]; then
		return 1
	fi
	chmod 700 "$runtime_base" || return 1
	theme_lock=$runtime_base/dwm-theme-apply.lock
	if [ -L "$theme_lock" ]; then
		return 1
	fi
	if [ -e "$theme_lock" ] &&
		{ [ ! -f "$theme_lock" ] || [ -L "$theme_lock" ] ||
			[ "$(file_stat u "$theme_lock")" != "$session_uid" ] ||
			[ "$(file_stat h "$theme_lock")" != 1 ]; }; then
		return 1
	fi
	if [ "$platform" = FreeBSD ]; then
		command -v lockf >/dev/null 2>&1 || return 1
	else
		command -v flock >/dev/null 2>&1 || return 1
	fi
	: >>"$theme_lock" || return 1
	chmod 600 "$theme_lock" || return 1
	exec 8>>"$theme_lock"
	if ! lock_theme_environment; then
		exec 8>&-
		return 1
	fi
	if [ -f "$theme_env" ] && [ ! -L "$theme_env" ] &&
		[ "$(file_stat u "$theme_env")" = "$session_uid" ] &&
		[ "$(file_stat h "$theme_env")" = 1 ] &&
		[ "$(file_stat s "$theme_env")" -le "$max_theme_environment_size" ] &&
		parse_theme_environment "$theme_env"; then
		QT_QPA_PLATFORMTHEME=$parsed_qt_theme
		XCURSOR_THEME=$parsed_cursor_theme
		XCURSOR_SIZE=$parsed_cursor_size
		export QT_QPA_PLATFORMTHEME XCURSOR_THEME XCURSOR_SIZE
	fi
	# Closing the last descriptor releases the lock before launching the app.
	exec 8>&-
}

[ "$#" -gt 0 ] || {
	printf 'usage: %s command [argument ...]\n' "$0" >&2
	exit 2
}

# Toolkit children need custom installation data roots even when launched
# from dwm's original environment after a theme change.
if [ "$platform" = FreeBSD ]; then
	# Native package desktop entries live under LOCALBASE, without an updater.
	XDG_DATA_DIRS=${XDG_DATA_DIRS:-/usr/local/share:/usr/share}
	export XDG_DATA_DIRS
else
	case $0 in
	*/bin/*) data_updater=${0%/*}/dwm-desktop-update ;;
	*) data_updater=$(command -v dwm-desktop-update 2>/dev/null || :) ;;
	esac
	if [ -n "$data_updater" ] && session_data_dirs=$("$data_updater" data-directories 2>/dev/null); then
		XDG_DATA_DIRS=$session_data_dirs
		export XDG_DATA_DIRS
	fi
fi

# A damaged optional environment record must not prevent application launch.
refresh_theme_environment || :
exec "$@"

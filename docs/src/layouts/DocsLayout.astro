---
import "../styles/global.css";
import { navigation, projectLinks } from "../data/navigation";

interface Props {
  title?: string;
  description?: string;
  eyebrow?: string;
  wide?: boolean;
  frontmatter?: {
    title?: string;
    description?: string;
    eyebrow?: string;
  };
}

const { frontmatter, wide = false } = Astro.props;
const title = Astro.props.title ?? frontmatter?.title ?? "Documentation";
const description = Astro.props.description ?? frontmatter?.description ?? "Documentation for the dwm-c9-freebsd FreeBSD 15.1 X11 desktop.";
const eyebrow = Astro.props.eyebrow ?? frontmatter?.eyebrow ?? "Documentation";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const localUrl = (href: string) => href.startsWith("/") ? base + href : href;
const pathname = Astro.url.pathname.slice(base.length) || "/";
const isCurrentGuide = ["/", "/index.html", "/install.html", "/documentation.html"].includes(pathname);
const currentHref = pathname === "/" || pathname === "/index.html" ? "/install.html" : pathname;
const pageIndex = Math.max(0, navigation.findIndex((item) => item.href === currentHref));
const previous = pageIndex > 0 ? navigation[pageIndex - 1] : undefined;
const next = pageIndex < navigation.length - 1 ? navigation[pageIndex + 1] : undefined;
const canonical = new URL(localUrl(pathname === "/index.html" ? "/" : pathname), Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0f0f" />
    <link rel="canonical" href={canonical} />
    <title>{title} | dwm-c9-freebsd</title>
    <script is:inline>
      document.documentElement.dataset.js = "true";
      try {
        const savedTheme = localStorage.getItem("dwm-docs-theme");
        const systemLight = window.matchMedia("(prefers-color-scheme: light)").matches;
        document.documentElement.dataset.theme = savedTheme || (systemLight ? "light" : "dark");
      } catch (_) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="site-header-inner">
        <button class="menu-button" type="button" aria-label="Open documentation navigation" aria-expanded="false" data-menu-button>
          <span></span><span></span><span></span>
        </button>
        <a class="site-brand" href={localUrl("/")} aria-label="dwm-c9-freebsd documentation home">
          <span class="site-mark">d</span>
          <span><strong>dwm-c9-freebsd</strong><small>FreeBSD 15.1 X11 desktop</small></span>
        </a>
        <div class="site-header-actions">
          <a class="header-link" href="https://github.com/lirux9873/dwm-c9-freebsd">View the source</a>
          <button class="theme-button" type="button" aria-label="Switch color theme" data-theme-button>
            <span class="theme-sun" aria-hidden="true">Light</span>
            <span class="theme-moon" aria-hidden="true">Dark</span>
          </button>
          <a class="repo-button" href="https://github.com/lirux9873/dwm-c9-freebsd">GitHub <span aria-hidden="true">-&gt;</span></a>
        </div>
      </div>
    </header>

    <div class="site-frame" data-wide={wide ? "true" : "false"}>
      <aside class="sidebar" aria-label="Documentation navigation">
        <div class="sidebar-intro">
          <span class="status-dot"></span>
          <span>FreeBSD port / X11</span>
        </div>
        <nav>
          <p class="nav-label">Guides and inherited references</p>
          <ol>
            {navigation.map((item) => {
              const active = item.href === currentHref;
              return (
                <li>
                  <a href={localUrl(item.href)} aria-current={active ? "page" : undefined}>
                    <span>{item.index}</span>
                    <strong>{item.label}</strong>
                  </a>
                </li>
              );
            })}
          </ol>
        </nav>
        <div class="sidebar-links">
          {projectLinks.map((link) => <a href={link.href}>{link.label} <span aria-hidden="true">-&gt;</span></a>)}
        </div>
        <p class="sidebar-note">Fast, focused, and built for keyboard-driven work.</p>
      </aside>

      <button class="sidebar-scrim" type="button" aria-label="Close documentation navigation" data-menu-close hidden></button>

      <main id="main-content" class="main-content">
        <div class="page-meta">
          <span>{eyebrow}</span>
          <span>FreeBSD migration in progress</span>
        </div>
        <article class:list={["doc-content", { "doc-content-wide": wide }]}>
          {!isCurrentGuide && <aside class="migration-notice"><strong>Inherited Fedora reference</strong><p>This page describes the upstream Linux desktop and has not been adapted to FreeBSD. Do not use its installation or system-service commands on FreeBSD. Start with the <a href={localUrl("/")}>FreeBSD guide</a> for supported scope and validation.</p></aside>}
          <slot />
        </article>
        <nav class="page-turner" aria-label="Previous and next documentation pages">
          {previous ? <a class="page-previous" href={localUrl(previous.href)}><span>Previous</span><strong>{previous.label}</strong></a> : <span></span>}
          {next ? <a class="page-next" href={localUrl(next.href)}><span>Next</span><strong>{next.label}</strong></a> : <span></span>}
        </nav>
        <footer class="site-footer">
          <p>dwm-c9-freebsd is an open source FreeBSD 15.1 X11 desktop.</p>
          <p><a href="https://github.com/lirux9873/dwm-c9-freebsd/blob/main/LICENSE">License</a> <span>/</span> <a href="https://github.com/lirux9873/dwm-c9-freebsd/issues">Report an issue</a></p>
        </footer>
      </main>
    </div>

    <script>
      const body = document.body;
      const menuButton = document.querySelector("[data-menu-button]");
      const menuClose = document.querySelector("[data-menu-close]");
      const sidebar = document.querySelector<HTMLElement>(".sidebar");
      const themeButton = document.querySelector("[data-theme-button]");
      const mobileMenu = window.matchMedia("(max-width: 820px)");

      const setMenu = (open: boolean) => {
        const openOnMobile = mobileMenu.matches && open;
        body.dataset.menuOpen = String(openOnMobile);
        menuButton?.setAttribute("aria-expanded", String(openOnMobile));
        menuButton?.setAttribute("aria-label", openOnMobile ? "Close documentation navigation" : "Open documentation navigation");
        sidebar?.toggleAttribute("inert", mobileMenu.matches && !openOnMobile);
        menuClose?.toggleAttribute("hidden", !openOnMobile);
      };

      menuButton?.addEventListener("click", () => setMenu(body.dataset.menuOpen !== "true"));
      menuClose?.addEventListener("click", () => setMenu(false));
      mobileMenu.addEventListener("change", () => setMenu(false));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setMenu(false);
      });

      setMenu(false);

      themeButton?.addEventListener("click", () => {
        const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = nextTheme;
        try { localStorage.setItem("dwm-docs-theme", nextTheme); } catch (_) {}
      });
    </script>
  </body>
</html>
